# YamuraLog hub configuration.
#
# Copy this file to the SD card as /config.ini (top level). If present, its
# values override the compiled defaults in src/WiFiSecrets.h at boot. Any field
# you omit keeps its compiled default. Sections and keys are case-insensitive.
# Lines starting with '#' or ';' are comments.

[wifi]
ssid=YOUR_SSID
password=YOUR_WIFI_PASSWORD

[ftp]
server=192.168.4.2
user=YOUR_FTP_USER
pass=YOUR_FTP_PASSWORD
path=/
port=21

# GPS time is UTC. Set utc_offset to your local offset from UTC in hours
# (local = UTC + offset) so logged SD file timestamps are local time.
# Examples: EDT -4, PST -8, CET 1, IST 5.5. Default 0 keeps UTC.
[time]
utc_offset=-4

# Space reserved for each new log file before logging starts, in MB. The card
# then never allocates clusters mid-run (avoids write stalls/dropped data); the
# file is cut back to its real size when logging stops. Set it above your
# longest session (rough guide: data rate x session length). 0 turns it off.
# Max 4095 (FAT32 file limit). Default 64.
[logging]
prealloc_mb=64

# One driver name per line. Shown in the Select Driver menu (max 24).
[drivers]
Pete
Aron
Zoey
Dora

# name of current selected driver
[selected driver]
Pete
